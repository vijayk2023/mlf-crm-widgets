// Single source of truth for the giving summary on a Contact.
// Called by the button wrapper (stampEmpty = true) and by mlf_refresh_pages (stampEmpty = false).
string standalone.mlf_aggregate_contact_giving(String id, Boolean stampEmpty)
{
contactId = id.trim();
if(contactId == null || contactId == "")
{
    return "Skipped: empty ID";
}
criteria = "(Contact:equals:" + contactId + ")";
allDonations = zoho.crm.searchRecords("Donation",criteria,1,200);
if(allDonations == null)
{
    allDonations = List();
}
// No donations: the button stamps the contact (clears stale values, sets Giving_Last_Updated); bulk refreshes skip them to save API calls
if(allDonations.size() == 0 && !stampEmpty)
{
    return "Skipped: no donations for " + contactId;
}
lifetimeTotal = 0.0;
giftAidTotal = 0.0;
lastDate = null;
lastAmount = 0.0;
ytdTotal = 0.0;
largestAmount = 0.0;
largestDate = null;
firstDate = null;
currentYear = zoho.currentdate.toString("yyyy");
yearMap = Map();
for each  don in allDonations
{
    received = don.get("Received_Amount");
    if(received == null || received == "")
    {
        received = "0";
    }
    received = received.toDecimal();
    ga = don.get("Gift_Aid_Amount");
    if(ga == null || ga == "")
    {
        ga = "0";
    }
    ga = ga.toDecimal();
    donDate = don.get("Donation_Date");
    if(donDate != null && donDate != "")
    {
        yr = donDate.toString().subString(0,4);
        // Totals are net (refunds/reversals are negative). Zero-amount records add nothing, so years with only those are left out of the breakdown
        if(received != 0)
        {
            prev = yearMap.get(yr);
            if(prev == null)
            {
                prev = 0.0;
            }
            yearMap.put(yr,prev + received);
        }
        if(yr == currentYear)
        {
            ytdTotal = ytdTotal + received;
        }
        // First, last and largest only consider real gifts (amount above zero)
        if(received > 0)
        {
            if(lastDate == null || donDate.toDate() > lastDate.toDate())
            {
                lastDate = donDate;
                lastAmount = received;
            }
            if(firstDate == null || donDate.toDate() < firstDate.toDate())
            {
                firstDate = donDate;
            }
            // Largest gift: higher amount wins; on a tie the more recent gift wins
            if(largestDate == null || received > largestAmount || (received == largestAmount && donDate.toDate() > largestDate.toDate()))
            {
                largestAmount = received;
                largestDate = donDate;
            }
        }
    }
    lifetimeTotal = lifetimeTotal + received;
    giftAidTotal = giftAidTotal + ga;
}
sortedYears = yearMap.keys().sort();
yearBreakdown = "";
for each  yr in sortedYears
{
    amt = yearMap.get(yr).round(2);
    if(yearBreakdown == "")
    {
        yearBreakdown = yr + ": £" + amt.toString();
    }
    else
    {
        yearBreakdown = yearBreakdown + " | " + yr + ": £" + amt.toString();
    }
}
today = zoho.currentdate.toString("yyyy-MM-dd");
updateMap = Map();
updateMap.put("Lifetime_Giving_Total",lifetimeTotal.round(2));
updateMap.put("Gift_Aid_Lifetime_Total",giftAidTotal.round(2));
updateMap.put("Last_Donation_Amount",lastAmount.round(2));
updateMap.put("Last_Donation_Date",lastDate);
updateMap.put("Giving_Year_Breakdown",yearBreakdown);
updateMap.put("Giving_Last_Updated",today);
updateMap.put("Giving_YTD_Total",ytdTotal.round(2));
updateMap.put("Largest_Donation_Amount",largestAmount.round(2));
updateMap.put("Largest_Donation_Date",largestDate);
updateMap.put("First_Donation_Date",firstDate);
updateResp = zoho.crm.updateRecord("Contacts",contactId,updateMap);
return "Updated: " + contactId + " | Lifetime: £" + lifetimeTotal.round(2).toString() + " | YTD: £" + ytdTotal.round(2).toString() + " | Largest: £" + largestAmount.round(2).toString() + " on " + largestDate + " | First: " + firstDate + " | UpdateResp: " + updateResp.toString();
}
