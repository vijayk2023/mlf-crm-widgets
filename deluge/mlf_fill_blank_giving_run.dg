void schedule.mlf_fill_blank_giving_run()
{
// Schedule wrapper for the D19 backfill. Each run starts from "0": Contacts already filled are no longer blank, so every run takes the next ~800.
// Attached to one-off schedules mlf_fill_blank_giving_01..11 (2026-11-10 01:00-06:00, every 30 min; the copy in Zoho still says "every 20 min" in this comment only). Throwaway after the backfill; the user deletes.
summary = standalone.mlf_fill_blank_giving("0");
info "Fill blank giving run complete. " + summary;
}
